# Root environment variables for development

# Node environment
NODE_ENV=development

# API Configuration
API_URL=http://localhost:8080
NEXT_PUBLIC_API_URL=http://localhost:8080

# Frontend URL
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_FRONTEND_URL=http://localhost:3000

# Better Auth
BETTER_AUTH_SECRET=your-secret-here-change-in-production
BETTER_AUTH_URL=http://localhost:3000

# Database (for local development)
DATABASE_URL=file:./.wrangler/state/v3/d1/miniflare-D1DatabaseObject/placeastro-dev.sqlite

# Cloudflare Account (optional for deployment)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=