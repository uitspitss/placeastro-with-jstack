{
  "name": "@placeastro/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev --local",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist node_modules .wrangler",
    "wrangler:types": "wrangler types && mv worker-configuration.d.ts src/types/worker-configuration.d.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.777.0",
    "@aws-sdk/s3-request-presigner": "^3.777.0",
    "@placeastro/database": "workspace:*",
    "@placeastro/shared": "workspace:*",
    "better-auth": "^1.2.1",
    "drizzle-orm": "^0.39.0",
    "hono": "^4.7.0",
    "jstack": "^1.0.6",
    "neverthrow": "^8.2.0",
    "superjson": "^2.2.1",
    "wrangler": "^3.72.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240815.0",
    "typescript": "^5"
  }
}