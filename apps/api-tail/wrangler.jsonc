{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "placeastro-api-tail",
  "compatibility_date": "2024-09-23",
  "main": "src/index.ts",

  // tail worker は HTTP エンドポイント不要（producer の tail_consumers から呼ばれる）。
  // 不要な *.workers.dev 公開 URL を作らない。
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },

  // Tail Worker 設定。placeastro-api の wrangler.jsonc の
  // tail_consumers.service = "placeastro-api-tail" がこの name を指す。
  //
  // SENTRY_DSN は秘密情報なのでここには置かない。デプロイ前に:
  //   wrangler secret put SENTRY_DSN
  //
  // 以下の vars は Cloudflare ネイティブ Sentry 連携（廃止済み）が
  // 設定していた値。デプロイ済み worker の現行値をダッシュボードで確認し、
  // 必要に応じて合わせること。
  "vars": {
    // Sentry event の logger タグに入る名前（従来値を踏襲）。
    "TAIL_WORKER_SCRIPT_NAME": "placeastro-server-tail",
    // Sentry に送らないリクエストヘッダー（小文字比較）。
    "BLOCKED_HEADERS": ["authorization", "cookie", "set-cookie", "x-api-key"],
    // ステータスコード→サンプリング率(0-100)。4xx/5xx を送信対象にする。
    // 404 は IGNORED_STATUS_CODES で個別に除外する。
    "STATUS_CODES_TO_SAMPLING_RATES": { "4xx": 100, "5xx": 100 },
    // 例外イベントのサンプリング率(0-100)。
    "EXCEPTION_SAMPLING_RATE": 100,
    // 「エラーではない期待される応答」として Sentry に送らないステータスコード。
    // 404(Not Found) はボット探索やリンク切れの正常応答なので既定で除外。
    "IGNORED_STATUS_CODES": [404]
  }
}
