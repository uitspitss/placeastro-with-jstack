{
  "name": "@placeastro/api-tail",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist node_modules .wrangler",
    "wrangler:types": "wrangler types && mv worker-configuration.d.ts src/types/worker-configuration.d.ts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240815.0",
    "typescript": "^5",
    "vitest": "^4.1.0",
    "wrangler": "^4.71.0"
  }
}
