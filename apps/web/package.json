    "@vitejs/plugin-react": "^4.3.4",
    "babel-plugin-react-compiler": "latest",
    "happy-dom": "^20.8.4",
    "postcss": "^8",
    "react-scan": "latest",
    "tailwindcss": "^4.0.0",
    "typescript": "^5",
    "vite": "^6.2.0",
    "vitest": "^4.1.0",
    "wrangler": "^4.71.0"
  }
