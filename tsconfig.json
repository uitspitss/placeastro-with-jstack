{
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "paths": {
      "@placeastro/ui": ["./packages/ui/src"],
      "@placeastro/database": ["./packages/database/src"],
      "@placeastro/shared": ["./packages/shared/src"]
    }
  },
  "exclude": ["node_modules"]
}
