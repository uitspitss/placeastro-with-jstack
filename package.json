{
  "name": "placeastro-monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.7.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "dev:stream": "turbo dev --ui=stream",
    "dev:api": "pnpm --filter @placeastro/api dev",
    "dev:web": "pnpm --filter @placeastro/web dev",
    "build": "turbo build",
    "build:api": "pnpm --filter @placeastro/api build",
    "build:web": "pnpm --filter @placeastro/web build",
    "deploy:api": "pnpm --filter @placeastro/api deploy",
    "lint": "biome lint .",
    "format": "biome format .",
    "check": "biome check .",
    "clean": "pnpm run --recursive clean && rm -rf .turbo",
    "clean:all": "pnpm clean && rm -rf node_modules pnpm-lock.yaml",
    "typecheck": "turbo typecheck",
    "types:generate": "pnpm --filter @placeastro/api wrangler:types",
    "db:generate": "pnpm --filter @placeastro/database generate",
    "db:migrate": "pnpm --filter @placeastro/database migrate",
    "db:studio": "pnpm --filter @placeastro/database studio",
    "db:migrate:local": "pnpm --filter @placeastro/database migrate:local",
    "db:seed:local": "pnpm --filter @placeastro/database seed:local",
    "setup": "pnpm install && pnpm types:generate && pnpm db:migrate:local"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@cloudflare/workers-types": "^4.20240815.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.6",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "better-sqlite3": "^11.8.1",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.5",
    "drizzle-kit": "^0.30.4",
    "npm-run-all2": "^7.0.2",
    "postcss": "^8",
    "tailwindcss": "^4.0.0",
    "turbo": "^2.8.14",
    "typescript": "^5",
    "wrangler": "^4.71.0"
  }
}
