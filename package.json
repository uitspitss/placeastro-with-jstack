{
  "name": "placeastro-with-jstack",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "run-p app:dev server:dev:worker db:studio",
    "app:dev": "next dev",
    "app:build": "next build",
    "app:start": "next start",
    "server:dev:worker": "wrangler dev --local",
    "db:generate:prod": "drizzle-kit generate",
    "db:migrate:prod": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "cross-env LOCAL_DB_PATH=$(find .wrangler/state/v3/d1/miniflare-D1DatabaseObject -type f -name '*.sqlite' -print -quit) drizzle-kit studio",
    "db:studio:prod": "drizzle-kit studio",
    "format": "biome format .",
    "lint": "biome lint .",
    "check": "biome check ."
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@tanstack/react-query": "^5.51.23",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.39.0",
    "hono": "^4.7.0",
    "jstack": "^1.0.6",
    "next": "^15.1.6",
    "postgres": "^3.4.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "superjson": "^2.2.1",
    "tailwind-merge": "^2.5.2",
    "wrangler": "^3.72.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@cloudflare/workers-types": "^4.20240815.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.6",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "better-sqlite3": "^11.8.1",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.5",
    "drizzle-kit": "^0.30.4",
    "eslint": "^9.18.0",
    "eslint-config-next": "^15.1.4",
    "eslint-plugin-drizzle": "^0.2.3",
    "npm-run-all": "^4.1.5",
    "postcss": "^8",
    "tailwindcss": "^4.0.0",
    "typescript": "^5"
  }
