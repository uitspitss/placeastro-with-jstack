{
  "name": "placeastro-with-jstack",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "cross-env LOCAL_DB_PATH=$(find .wrangler/state/v3/d1/miniflare-D1DatabaseObject -type f -name '*.sqlite' -print -quit) && run-p app:dev server:dev:worker db:studio",
    "set-local-env": "cross-env LOCAL_DB_PATH=$(find .wrangler/state/v3/d1/miniflare-D1DatabaseObject -type f -name '*.sqlite' -print -quit)",
    "app:dev": "NODE_OPTIONS='--inspect' next dev",
    "app:build": "next build",
    "app:start": "next start",
    "server:dev:worker": "wrangler dev --local",
    "db:generate": "cross-env LOCAL_DB_PATH=$(find .wrangler/state/v3/d1/miniflare-D1DatabaseObject -type f -name '*.sqlite' -print -quit) drizzle-kit generate",
    "db:migrate": "wrangler d1 execute placeastro --local",
    "db:migrate:prod": "cross-env NODE_ENV=production drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "cross-env LOCAL_DB_PATH=$(find .wrangler/state/v3/d1/miniflare-D1DatabaseObject -type f -name '*.sqlite' -print -quit) drizzle-kit studio",
    "db:studio:prod": "cross-env NODE_ENV=production drizzle-kit studio",
    "format": "biome format .",
    "lint": "biome lint .",
    "check": "biome check .",
    "wrangler:types": "wrangler types && mv worker-configuration.d.ts src/types/worker-configuration.d.ts && sed -i '' 's/interface/export interface/' src/types/worker-configuration.d.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.777.0",
    "@aws-sdk/s3-request-presigner": "^3.777.0",
    "@hookform/resolvers": "^4.1.3",
    "@tailwindcss/postcss": "^4.0.0",
    "@tanstack/react-query": "^5.51.23",
    "@uppy/core": "^4.4.3",
    "@uppy/dashboard": "^4.3.2",
    "@uppy/drag-drop": "^4.1.1",
    "@uppy/file-input": "^4.1.1",
    "@uppy/progress-bar": "^4.2.1",
    "@uppy/react": "^4.2.2",
    "better-auth": "^1.2.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.39.0",
    "hono": "^4.7.0",
    "jstack": "^1.0.6",
    "next": "^15.1.6",
    "postgres": "^3.4.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.55.0",
    "superjson": "^2.2.1",
    "tailwind-merge": "^2.5.2",
    "wrangler": "^3.72.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@cloudflare/workers-types": "^4.20240815.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.6",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "better-sqlite3": "^11.8.1",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.5",
    "drizzle-kit": "^0.30.4",
    "npm-run-all2": "^5.0.0",
    "postcss": "^8",
    "tailwindcss": "^4.0.0",
    "typescript": "^5"
  },
  "volta": {
    "node": "22.14.0",
    "pnpm": "10.5.2"
  }
}
