{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "workspaces": {
    "apps/web": {
      "project": ["src/**/*.{ts,tsx}"],
      "ignoreDependencies": [
        "@tailwindcss/postcss",
        "postcss",
        "tailwindcss",
        "tw-animate-css"
      ],
      "rules": {
        "devDependencies": "warn",
        "exports": "warn"
      }
    },
    "apps/api": {
      "project": ["src/**/*.{ts,tsx}"],
      "entry": ["src/index.ts"]
    },
    "packages/shared": {
      "project": ["src/**/*.{ts,tsx}"],
      "entry": ["src/index.ts"]
    },
    "packages/database": {
      "project": ["src/**/*.{ts,tsx}"],
      "entry": ["src/index.ts"]
    },
    "packages/ui": {
      "project": ["src/**/*.{ts,tsx}"],
      "entry": ["src/index.ts"]
    }
  }
}
